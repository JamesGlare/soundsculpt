// coloured-shift-reverb : reverb_core.genexpr
//
// Stereo coloured smear/bloom core. The smear stage now uses 8 Schroeder
// allpass filters on real delay lines (4 per channel) with per-line LFO
// modulation of the read time when analog>0 -> chorus / spring-style
// wobble in the tail. Per-channel feedback memories outside the smear keep
// the bloom character and stereo cross-coupling so the image breathes
// instead of two independent monos sitting side by side.
//
// Inlets:
//   in 1, in 2 : dry stereo input
// Outlets:
//   out 1, out 2: 100% wet stereo output. Wrapper handles dry/wet.
//
// Params:
//   drive   : 0..1 input/feedback nonlinearity amount.
//   tone    : 0..1 dark <-> bright tilt on the input colour.
//   size    : 0..1 smear amount, base delay-line length, and L/R cross
//             coupling strength.
//   decay   : 0..1 feedback gain.
//   damping : 0..1 highs lost per pass (1 = darkest).
//   analog  : 0..1 amount of "analog" colour. Single dial gates six tricks:
//              - asymmetric DC bias before tanh -> even-harmonic distortion
//              - asymmetric soft-clip (different gain on positive vs negative
//                halves of the curve) -> tube/triode-style asymmetric drive
//              - pre-emphasis going into the feedback loop, de-emphasis at
//                output -> tape-like per-pass darkening
//              - L/R asymmetry on the bias and tilt for analog stereo drift
//              - low-amplitude pseudo-noise injection in the feedback path
//              - LFO modulation of the smear delay times -> chorus/spring
//                wobble in the tail (decorrelated phases per line, L/R)

// All Param + History declarations MUST precede any expression in a codebox.
Param drive(0.2);
Param tone(0.5);
Param size(0.5);
Param decay(0.55);
Param damping(0.45);
Param analog(0.0);

// Per-channel one-pole damping cascade (4 stages each).
History Llp1(0); History Llp2(0); History Llp3(0); History Llp4(0);
History Rlp1(0); History Rlp2(0); History Rlp3(0); History Rlp4(0);

// Per-channel feedback memories (4 nodes each).
History Lfb1(0); History Lfb2(0); History Lfb3(0); History Lfb4(0);
History Rfb1(0); History Rfb2(0); History Rfb3(0); History Rfb4(0);

// Schroeder-allpass-on-delay-line state. Each delay holds the internal
// allpass state v[n] = x[n] + g * v[n-D]; output is y = -g*v + v[n-D].
// Buffers are sized to comfortably hold base length + modulation depth
// + linear-interp margin.
Delay LapD1(1024);
Delay LapD2(1024);
Delay LapD3(1024);
Delay LapD4(1024);
Delay RapD1(1024);
Delay RapD2(1024);
Delay RapD3(1024);
Delay RapD4(1024);

// Per-line LFO phase accumulators (8 decorrelated phases). Stored as
// 0..1, wrapped per sample.
History phL1(0); History phL2(0.13); History phL3(0.27); History phL4(0.41);
History phR1(0.08); History phR2(0.22); History phR3(0.36); History phR4(0.5);

// Pre-emphasis filter state (one-pole high-shelf approximation per channel).
History LpreHi(0);
History RpreHi(0);

// Pseudo-noise state (cheap LCG-style scrambler, signal-rate).
History noiseSt(123456789);

// --- Pseudo-noise generator (cheap, signal-rate, deterministic). ---
// LCG-ish step on a 32-bit-ish space then scaled to ~[-1, 1).
nNew = (noiseSt * 1664525 + 1013904223) % 2147483647;
noiseSt = nNew;
nf = (nNew / 1073741823.5) - 1.0;   // ~[-1, 1)

// --- Pre-emphasis going in (boost highs before saturation/feedback). ---
// One-pole high-shelf via "input - lowpassed input" boost.
// At analog = 1 we add ~+6 dB of >2-3 kHz lift into the loop.
preCoef = 0.18; // fixed lowpass corner for the shelf split
LpreHiNext = LpreHi + (in1 - LpreHi) * preCoef;
RpreHiNext = RpreHi + (in2 - RpreHi) * preCoef;
preBoost = analog * 0.7;
xL = in1 + (in1 - LpreHiNext) * preBoost;
xR = in2 + (in2 - RpreHiNext) * preBoost;

// --- Asymmetric soft-clip gain (used everywhere we used to call plain tanh). ---
// y = tanh(x * (1 + asymGain * sign(x))).
// At asymGain=0 this is plain tanh. At asymGain>0 the positive half compresses
// harder than the negative half (or vice versa), giving even-harmonic content
// independent of (and stacking with) the DC bias trick below.
asymGain = analog * 0.20;

// --- Input colour stage (per channel, bias + asymmetric soft-clip). ---
preGain = 1 + drive * 4;
// Asymmetric DC bias before saturation -> even harmonics. L and R get opposite
// biases so the stereo image drifts apart slightly when analog goes up.
biasL = analog * 0.18;
biasR = analog * -0.15;  // not the same magnitude on purpose
inArgL = xL * preGain + biasL;
inArgR = xR * preGain + biasR;
colL = tanh(inArgL * (1 + asymGain * sign(inArgL))) - tanh(biasL * (1 + asymGain * sign(biasL)));
colR = tanh(inArgR * (1 + asymGain * sign(inArgR))) - tanh(biasR * (1 + asymGain * sign(biasR)));

mixAmt = 0.2 + drive * 0.55;
cL = mix(xL, colL, mixAmt);
cR = mix(xR, colR, mixAmt);

// Tone tilt around the first lowpass tap, with subtle L/R asymmetry when
// analog is up so the two channels never sound identically EQ'd.
brightL = cL - Llp1;
brightR = cR - Rlp1;
tiltScaleL = 1.6 + analog * 0.10;
tiltScaleR = 1.6 - analog * 0.10;
tiltL = mix(Llp1, brightL * tiltScaleL, tone);
tiltR = mix(Rlp1, brightR * tiltScaleR, tone);

// --- Damping cascade. ---
// Slight L/R drift on damping coefficient when analog > 0.
dampBase = 0.08 + (1 - damping) * 0.5;
dampL = dampBase * (1.0 + analog * 0.04);
dampR = dampBase * (1.0 - analog * 0.04);

l1L = Llp1 + (tiltL - Llp1) * dampL;
l2L = Llp2 + (l1L  - Llp2) * dampL;
l3L = Llp3 + (l2L  - Llp3) * dampL;
l4L = Llp4 + (l3L  - Llp4) * dampL;

l1R = Rlp1 + (tiltR - Rlp1) * dampR;
l2R = Rlp2 + (l1R  - Rlp2) * dampR;
l3R = Rlp3 + (l2R  - Rlp3) * dampR;
l4R = Rlp4 + (l3R  - Rlp4) * dampR;

// --- Smear: 8 Schroeder allpasses on modulated delay lines. ---
// g is the allpass coefficient; same range as before so 'size' still
// controls smear depth. Base delay lengths are prime-ish to decorrelate
// the modes; size also scales the lengths so smaller size = tighter,
// shorter smear, larger size = bigger room.
g = 0.18 + size * 0.42;
lenScale = 0.5 + size * 0.9;       // 0.5x .. 1.4x at size 0..1

// Base lengths in samples (prime-ish, decorrelated L vs R).
bL1 = 199 * lenScale; bL2 = 349 * lenScale; bL3 = 571 * lenScale; bL4 = 787 * lenScale;
bR1 = 241 * lenScale; bR2 = 389 * lenScale; bR3 = 617 * lenScale; bR4 = 839 * lenScale;

// LFO frequencies (Hz) per line. Mutually inharmonic so the modulation
// never lines up across lines.
fL1 = 0.31; fL2 = 0.47; fL3 = 0.59; fL4 = 0.71;
fR1 = 0.37; fR2 = 0.53; fR3 = 0.61; fR4 = 0.79;
TWO_PI = 6.283185307179586;
srInv = 1.0 / samplerate;

// Advance phases (wrap to [0,1)).
phL1n = phL1 + fL1 * srInv;  phL1n = phL1n - floor(phL1n);
phL2n = phL2 + fL2 * srInv;  phL2n = phL2n - floor(phL2n);
phL3n = phL3 + fL3 * srInv;  phL3n = phL3n - floor(phL3n);
phL4n = phL4 + fL4 * srInv;  phL4n = phL4n - floor(phL4n);
phR1n = phR1 + fR1 * srInv;  phR1n = phR1n - floor(phR1n);
phR2n = phR2 + fR2 * srInv;  phR2n = phR2n - floor(phR2n);
phR3n = phR3 + fR3 * srInv;  phR3n = phR3n - floor(phR3n);
phR4n = phR4 + fR4 * srInv;  phR4n = phR4n - floor(phR4n);

// Modulation depth in samples, gated by analog. ~12 samples at full.
modDepth = analog * 12;

// Final read times (always >= 4 samples for safe linear interp).
dL1 = max(4, bL1 + modDepth * sin(phL1n * TWO_PI));
dL2 = max(4, bL2 + modDepth * sin(phL2n * TWO_PI));
dL3 = max(4, bL3 + modDepth * sin(phL3n * TWO_PI));
dL4 = max(4, bL4 + modDepth * sin(phL4n * TWO_PI));
dR1 = max(4, bR1 + modDepth * sin(phR1n * TWO_PI));
dR2 = max(4, bR2 + modDepth * sin(phR2n * TWO_PI));
dR3 = max(4, bR3 + modDepth * sin(phR3n * TWO_PI));
dR4 = max(4, bR4 + modDepth * sin(phR4n * TWO_PI));

// Schroeder allpass on delay line. v[n] = x + g*v[n-D]; y = -g*v + v[n-D].
vDelL1 = LapD1.read(dL1, interp="linear"); vL1 = l1L + g * vDelL1; sL1 = -g * vL1 + vDelL1; LapD1.write(vL1);
vDelL2 = LapD2.read(dL2, interp="linear"); vL2 = l2L + g * vDelL2; sL2 = -g * vL2 + vDelL2; LapD2.write(vL2);
vDelL3 = LapD3.read(dL3, interp="linear"); vL3 = l3L + g * vDelL3; sL3 = -g * vL3 + vDelL3; LapD3.write(vL3);
vDelL4 = LapD4.read(dL4, interp="linear"); vL4 = l4L + g * vDelL4; sL4 = -g * vL4 + vDelL4; LapD4.write(vL4);
vDelR1 = RapD1.read(dR1, interp="linear"); vR1 = l1R + g * vDelR1; sR1 = -g * vR1 + vDelR1; RapD1.write(vR1);
vDelR2 = RapD2.read(dR2, interp="linear"); vR2 = l2R + g * vDelR2; sR2 = -g * vR2 + vDelR2; RapD2.write(vR2);
vDelR3 = RapD3.read(dR3, interp="linear"); vR3 = l3R + g * vDelR3; sR3 = -g * vR3 + vDelR3; RapD3.write(vR3);
vDelR4 = RapD4.read(dR4, interp="linear"); vR4 = l4R + g * vDelR4; sR4 = -g * vR4 + vDelR4; RapD4.write(vR4);

// --- Feedback bloom with cross-channel coupling. ---
fbAmt   = 0.18 + decay * 0.78;
intra   = 0.05 + size * 0.18;     // within-channel cross between nodes
crossLR = 0.10 + size * 0.30;     // L<->R coupling, scaled with size

// Tiny noise injection scaled by analog. Floor sits ~ -66 dB at analog=1.
nAmp = analog * 0.0005;
nL = nf * nAmp;
nR = nf * nAmp * 0.97;             // not perfectly correlated

// Per-node asymmetric saturation: bias + asym soft-clip.
// Bias is constant per node, so the DC compensation can be precomputed.
fbBias    = analog * 0.08;
fbBiasNeg = -fbBias;
fbBiasComp    = tanh(fbBias    * (1 + asymGain));   // sign(+fbBias) = 1
fbBiasNegComp = tanh(fbBiasNeg * (1 - asymGain));   // sign(-fbBias) = -1

a1L = sL1 + Lfb1 * fbAmt + Lfb3 * intra * 0.7 + Rfb2 * crossLR * 0.5 + fbBias    + nL;
a2L = sL2 + Lfb2 * fbAmt - Lfb4 * intra * 0.7 + Rfb3 * crossLR * 0.5 + fbBiasNeg + nL;
a3L = sL3 + Lfb3 * fbAmt + Lfb1 * intra       - Rfb4 * crossLR * 0.5 + fbBias    + nL;
a4L = sL4 + Lfb4 * fbAmt - Lfb2 * intra       + Rfb1 * crossLR * 0.5 + fbBiasNeg + nL;
n1L = tanh(a1L * (1 + asymGain * sign(a1L))) - fbBiasComp;
n2L = tanh(a2L * (1 + asymGain * sign(a2L))) - fbBiasNegComp;
n3L = tanh(a3L * (1 + asymGain * sign(a3L))) - fbBiasComp;
n4L = tanh(a4L * (1 + asymGain * sign(a4L))) - fbBiasNegComp;

a1R = sR1 + Rfb1 * fbAmt + Rfb3 * intra * 0.7 + Lfb2 * crossLR * 0.5 + fbBiasNeg + nR;
a2R = sR2 + Rfb2 * fbAmt - Rfb4 * intra * 0.7 + Lfb3 * crossLR * 0.5 + fbBias    + nR;
a3R = sR3 + Rfb3 * fbAmt + Rfb1 * intra       - Lfb4 * crossLR * 0.5 + fbBiasNeg + nR;
a4R = sR4 + Rfb4 * fbAmt - Rfb2 * intra       + Lfb1 * crossLR * 0.5 + fbBias    + nR;
n1R = tanh(a1R * (1 + asymGain * sign(a1R))) - fbBiasNegComp;
n2R = tanh(a2R * (1 + asymGain * sign(a2R))) - fbBiasComp;
n3R = tanh(a3R * (1 + asymGain * sign(a3R))) - fbBiasNegComp;
n4R = tanh(a4R * (1 + asymGain * sign(a4R))) - fbBiasComp;

bodyL = (n1L + n2L + n3L + n4L) * 0.25;
bodyR = (n1R + n2R + n3R + n4R) * 0.25;

bArgL = bodyL * (1.1 + drive * 0.35);
bArgR = bodyR * (1.1 + drive * 0.35);
bodyL = tanh(bArgL * (1 + asymGain * sign(bArgL)));
bodyR = tanh(bArgR * (1 + asymGain * sign(bArgR)));

// --- De-emphasis on the way out (gentle high-shelf cut). ---
// Cancels the steady-state lift of pre-emphasis on the dry path while
// leaving the feedback path naturally darker each pass (because each pass
// gets pre-emph'd again on the way back in but the de-emph only fires
// once at the output).
deCoef = 0.18;
LdeOut = LpreHi + (bodyL - LpreHi) * deCoef; // reuse one-pole, separate state would be cleaner
RdeOut = RpreHi + (bodyR - RpreHi) * deCoef; // (acceptable here because pre-emph state is also overwritten this sample)
deCut = analog * 0.6;
bodyL = bodyL - (bodyL - LdeOut) * deCut;
bodyR = bodyR - (bodyR - RdeOut) * deCut;

// --- State updates. ---
Llp1 = l1L; Llp2 = l2L; Llp3 = l3L; Llp4 = l4L;
Rlp1 = l1R; Rlp2 = l2R; Rlp3 = l3R; Rlp4 = l4R;
Lfb1 = n1L; Lfb2 = n2L; Lfb3 = n3L; Lfb4 = n4L;
Rfb1 = n1R; Rfb2 = n2R; Rfb3 = n3R; Rfb4 = n4R;
phL1 = phL1n; phL2 = phL2n; phL3 = phL3n; phL4 = phL4n;
phR1 = phR1n; phR2 = phR2n; phR3 = phR3n; phR4 = phR4n;
LpreHi = LpreHiNext;
RpreHi = RpreHiNext;

out1 = bodyL;
out2 = bodyR;
